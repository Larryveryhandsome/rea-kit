# 一般使用者不用這個檔：雙擊「開始設定.vbs」用一鍵串接精靈設定即可。
# 雲端／Docker 部署才在平台的「私密環境變數」設定下列欄位（環境變數優先於精靈存的設定）。
# 每一項怎麼申請見 docs/金鑰申請.md。不要把真值寫進任何會進 git 的檔案。

# LINE 官方帳號（必要）
REA_SHARED_LINE_SECRET=
REA_SHARED_LINE_TOKEN=
REA_PUBLIC_BASE=
REA_ADMIN_USERS=
# invite（預設，只限受邀）或 open
REA_SIGNUP_MODE=

# 591／樂屋新物件、海巡（選用）：brave 或 serper
REA_SEARCH_PROVIDER=
REA_SEARCH_KEY=

# Google 試算表（選用）
REA_GSHEET_CUSTOMERS_URL=
REA_GSHEET_LISTINGS_URL=

# 內政部實價登錄（選用，免金鑰）
REA_LVR_COUNTIES=

# 地政整合資訊服務共享協作平台（選用、按筆付費）
REA_MOI_CLIENT_ID=
REA_MOI_SECRET=
REA_MOI_DAILY_LIMIT=20

# 執行
REA_DATA_DIR=
REA_BIND_HOST=127.0.0.1
PORT=8080
REA_PROVIDER_NAME=

# 只模擬不送出：設成 1，主動推播（今日報告、新物件通知）整條流程照跑，但不會連 LINE、不耗額度；
# 紀錄印在 data/logs/server.log（[dry-run]）。要正式推播就清空或刪掉這一行。
REA_PUSH_DRY_RUN=
